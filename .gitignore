# Coordenadas de evidencias arqueologicas sensibles o no publicadas: NO van
# al repositorio publico. Todo lo de datos/ y derivados/ es reproducible
# corriendo los pasos, asi que no se pierde nada por excluirlo.
datos/
derivados/

# Los resultados si se versionan (tablas y figuras, sin coordenadas crudas),
# menos las geometrias.
resultados/*.gpkg
resultados/*.shp
resultados/*.geojson

# La llave de OpenTopography va en la variable de entorno, no en el archivo.
.env

__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.parcial
